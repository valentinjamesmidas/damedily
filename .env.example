# Veřejná URL Supabase (lokálně typicky http://127.0.0.1:54321).
NEXT_PUBLIC_SUPABASE_URL=

# Anon / publishable klíč pro prohlížeč. Nikdy sem nedávejte service role.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Jen server. Nesmí mít prefix NEXT_PUBLIC_ a nesmí se commitovat s hodnotou.
SUPABASE_SERVICE_ROLE_KEY=

# Jen server. Klíč xAI, do repozitáře nikdy s hodnotou.
XAI_API_KEY=

# ID modelů. Výchozí grok-4.7 umí text i obrázky. Samostatný grok-vision v API není.
XAI_TEXT_MODEL=grok-4.7
XAI_VISION_MODEL=grok-4.7

# Volitelné. Když chybí, klient použije https://api.x.ai/v1, timeout 120 s a 2 opakování.
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_TIMEOUT_MS=120000
# XAI_MAX_RETRIES=2
